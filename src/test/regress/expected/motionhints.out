-- TODO: Look at these later...
/*+ Broadcast(t2) Redistribute(t1) */
EXPLAIN (costs off) SELECT * FROM heap_table t2 WHERE t2.b NOT IN (SELECT t1.a FROM heap_table t1);
                          QUERY PLAN                           
---------------------------------------------------------------
 Gather Motion 1:1  (slice1; segments: 1)
   ->  Hash Left Anti Semi (Not-In) Join
         Hash Cond: (t2.b = t1.a)
         ->  Broadcast Motion 3:1  (slice2; segments: 3)
               ->  Seq Scan on heap_table t2
         ->  Hash
               ->  Broadcast Motion 3:1  (slice3; segments: 3)
                     ->  Seq Scan on heap_table t1
 Optimizer: GPORCA
(9 rows)

