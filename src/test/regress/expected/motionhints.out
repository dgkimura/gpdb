 Optimizer: GPORCA
(10 rows)

/*+ Redistribute(rt) Broadcast(ht) */
SELECT * FROM rep_table rt INNER JOIN heap_table ht ON rt.b = ht.a WHERE ht.a=3;
 a | b | a | b 
---+---+---+---
