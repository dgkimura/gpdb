-- Test Optimizer Row Hints Feature
--
-- Purpose: Test that join hints may be used to edit cardinality estimates
LOAD 'pg_hint_plan';
DROP SCHEMA IF EXISTS joinhints CASCADE;
CREATE SCHEMA joinhints;
SET search_path=joinhints;
SET optimizer_trace_fallback=on;
-- Setup tables
CREATE TABLE t1(a int, b int);
CREATE TABLE t2(a int, b int);
CREATE TABLE t3(a int, b int);
CREATE TABLE t4(a int, b int);
CREATE TABLE t5(a int, b int);
-- Baseline no hints
EXPLAIN (costs off) SELECT t1.a, t2.a FROM t1, t2, t3, t4, t5;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Nested Loop
         Join Filter: true
         ->  Nested Loop
               Join Filter: true
               ->  Nested Loop
                     Join Filter: true
                     ->  Nested Loop
                           Join Filter: true
                           ->  Seq Scan on t1
                           ->  Materialize
                                 ->  Broadcast Motion 3:3  (slice5; segments: 3)
                                       ->  Seq Scan on t3
                     ->  Materialize
                           ->  Broadcast Motion 3:3  (slice4; segments: 3)
                                 ->  Seq Scan on t4
               ->  Materialize
                     ->  Broadcast Motion 3:3  (slice3; segments: 3)
                           ->  Seq Scan on t5
         ->  Materialize
               ->  Broadcast Motion 3:3  (slice2; segments: 3)
                     ->  Seq Scan on t2
 Optimizer: GPORCA
(23 rows)

/*+
    Leading((t5 (((t4 t3) t2) t1)))
 */
EXPLAIN (costs off) SELECT t1.a, t2.a FROM t1, t2, t3, t4, t5;
                                         QUERY PLAN                                          
---------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Nested Loop
         Join Filter: true
         ->  Nested Loop
               Join Filter: true
               ->  Broadcast Motion 3:3  (slice3; segments: 3)
                     ->  Nested Loop
                           Join Filter: true
                           ->  Seq Scan on t2
                           ->  Materialize
                                 ->  Broadcast Motion 3:3  (slice4; segments: 3)
                                       ->  Nested Loop
                                             Join Filter: true
                                             ->  Broadcast Motion 3:3  (slice5; segments: 3)
                                                   ->  Seq Scan on t3
                                             ->  Seq Scan on t4
               ->  Seq Scan on t1
         ->  Materialize
               ->  Broadcast Motion 3:3  (slice2; segments: 3)
                     ->  Seq Scan on t5
 Optimizer: GPORCA
(21 rows)

/*+
    Leading((t2 ((t5 t4) (t1 t3))))
 */
EXPLAIN SELECT t1.a, t2.a FROM my_table AS t1, your_table AS t2, our_table AS t3, their_table AS t4, everybody_table AS t5;
